/* ==================================================================
   DEXTER INDUSTRIES — MAIN SCRIPT
   Handles: loader, sticky nav, counters, AOS/Swiper/Typed init,
   decomposition timeline animation, back-to-top, form handling.
================================================================== */

document.addEventListener('DOMContentLoaded', function () {

  /* ---------------------------------------------------------------
     1. LOADING SCREEN
  ---------------------------------------------------------------- */
  const loader = document.getElementById('loader');
  window.addEventListener('load', function () {
    setTimeout(function () {
      if (loader) loader.classList.add('loaded');
    }, 400);
  });

  /* ---------------------------------------------------------------
     2. AOS — SCROLL ANIMATIONS
  ---------------------------------------------------------------- */
  if (window.AOS) {
    AOS.init({
      duration: 700,
      easing: 'ease-out-cubic',
      once: true,
      offset: 60
    });
  }

  /* ---------------------------------------------------------------
     3. STICKY / DARK HEADER ON SCROLL
  ---------------------------------------------------------------- */
  const mainNav = document.getElementById('mainNav');
  const backToTop = document.getElementById('backToTop');

  function handleScrollUI() {
    const scrollY = window.scrollY;
    if (mainNav) {
      scrollY > 60 ? mainNav.classList.add('scrolled') : mainNav.classList.remove('scrolled');
    }
    if (backToTop) {
      scrollY > 500 ? backToTop.classList.add('show') : backToTop.classList.remove('show');
    }
  }
  handleScrollUI();
  window.addEventListener('scroll', handleScrollUI, { passive: true });

  if (backToTop) {
    backToTop.addEventListener('click', function () {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  /* ---------------------------------------------------------------
     4. STATISTICS COUNTER (fires once each stat enters viewport)
  ---------------------------------------------------------------- */
  const counters = document.querySelectorAll('.stat-num');
  const counterObserver = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (!entry.isIntersecting) return;
      const el = entry.target;
      const target = parseInt(el.getAttribute('data-count'), 10) || 0;
      const duration = 1600;
      const start = performance.now();

      function tick(now) {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3); // ease-out-cubic
        el.textContent = Math.floor(eased * target);
        if (progress < 1) {
          requestAnimationFrame(tick);
        } else {
          el.textContent = target;
        }
      }
      requestAnimationFrame(tick);
      counterObserver.unobserve(el);
    });
  }, { threshold: 0.6 });

  counters.forEach(function (el) { counterObserver.observe(el); });

  /* ---------------------------------------------------------------
     5. TYPED.JS — ROTATING HEADLINE (audience list)
  ---------------------------------------------------------------- */
  if (window.Typed && document.querySelector('.typed-target')) {
    new Typed('.typed-target', {
      strings: [
        'importers &amp; wholesalers',
        'supermarkets &amp; retail chains',
        'municipal corporations',
        'hospitals &amp; hotels',
        'private label brands'
      ],
      typeSpeed: 45,
      backSpeed: 25,
      backDelay: 1600,
      loop: true,
      smartBackspace: true
    });
  }

  /* ---------------------------------------------------------------
     6. SWIPER — FACTORY GALLERY
  ---------------------------------------------------------------- */
  if (window.Swiper) {
    new Swiper('.factory-swiper', {
      slidesPerView: 1.15,
      spaceBetween: 20,
      loop: true,
      autoplay: { delay: 3200, disableOnInteraction: false },
      pagination: { el: '.factory-swiper .swiper-pagination', clickable: true },
      breakpoints: {
        576: { slidesPerView: 2, spaceBetween: 20 },
        992: { slidesPerView: 3.2, spaceBetween: 24 },
        1400: { slidesPerView: 4, spaceBetween: 24 }
      }
    });

    /* ---------------------------------------------------------------
       7. SWIPER — TESTIMONIALS
    ---------------------------------------------------------------- */
    new Swiper('.testimonial-swiper', {
      slidesPerView: 1,
      spaceBetween: 24,
      loop: true,
      autoplay: { delay: 4200, disableOnInteraction: false },
      pagination: { el: '.testimonial-swiper .swiper-pagination', clickable: true },
      breakpoints: {
        992: { slidesPerView: 2 }
      }
    });
  }

  /* ---------------------------------------------------------------
     8. SIGNATURE ELEMENT — DECOMPOSITION TIMELINE
     Animates the hero's compostability progress bar and day counter
     once it scrolls into view, looping to illustrate the process.
  ---------------------------------------------------------------- */
  const decomposeFill = document.getElementById('decomposeFill');
  const dayCounter = document.getElementById('dayCounter');
  const dcStatus = document.getElementById('dcStatus');

  if (decomposeFill && dayCounter && dcStatus) {
    const TOTAL_DAYS = 180;
    const statusStops = [
      { pct: 0, day: 0, label: 'Bag intact' },
      { pct: 45, day: 80, label: 'Fragmenting' },
      { pct: 90, day: 160, label: 'Breaking down' },
      { pct: 100, day: 180, label: 'Fully composted' }
    ];

    function runDecomposeCycle() {
      let frame = 0;
      const totalFrames = 240;

      function step() {
        frame++;
        const progress = Math.min(frame / totalFrames, 1);
        const pct = progress * 100;
        const day = Math.floor(progress * TOTAL_DAYS);

        decomposeFill.style.width = pct + '%';
        dayCounter.textContent = day;

        let currentLabel = statusStops[0].label;
        for (let i = 0; i < statusStops.length; i++) {
          if (pct >= statusStops[i].pct) currentLabel = statusStops[i].label;
        }
        dcStatus.textContent = currentLabel;

        if (progress < 1) {
          requestAnimationFrame(step);
        } else {
          setTimeout(function () {
            decomposeFill.style.width = '0%';
            dayCounter.textContent = '0';
            dcStatus.textContent = 'Bag intact';
            setTimeout(runDecomposeCycle, 1200);
          }, 2500);
        }
      }
      requestAnimationFrame(step);
    }

    const decomposeObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          runDecomposeCycle();
          decomposeObserver.disconnect();
        }
      });
    }, { threshold: 0.4 });

    decomposeObserver.observe(decomposeFill.closest('.decompose-card'));
  }

  /* ---------------------------------------------------------------
     9. CONTACT FORM — CLIENT-SIDE VALIDATION + SUCCESS STATE
     NOTE: replace the fetch() target below with your live form
     endpoint (e.g. Formspree, custom API) before going to production.
  ---------------------------------------------------------------- */
  const enquiryForm = document.getElementById('enquiryForm');
  const formSuccess = document.getElementById('formSuccess');

  if (enquiryForm) {
    enquiryForm.addEventListener('submit', function (e) {
      e.preventDefault();

      if (!enquiryForm.checkValidity()) {
        enquiryForm.classList.add('was-validated');
        return;
      }

      // Placeholder submit handler — wire to your backend / form service.
      formSuccess.hidden = false;
      enquiryForm.reset();
      enquiryForm.classList.remove('was-validated');

      setTimeout(function () { formSuccess.hidden = true; }, 6000);
    });
  }

  /* ---------------------------------------------------------------
     10. FOOTER — DYNAMIC YEAR
  ---------------------------------------------------------------- */
  const yearEl = document.getElementById('year');
  if (yearEl) yearEl.textContent = new Date().getFullYear();

});